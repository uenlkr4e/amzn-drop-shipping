{
  "openapi": "3.0.0",
  "paths": {
    "/api/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/ops/status": {
      "get": {
        "operationId": "OpsController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsStatusDto"
                }
              }
            }
          }
        },
        "tags": [
          "ops"
        ]
      }
    }
  },
  "info": {
    "title": "Dropship Platform API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "operator",
              "viewer"
            ]
          },
          "twoFactorEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "twoFactorEnabled"
        ]
      },
      "QueueStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "waiting": {
            "type": "number"
          },
          "active": {
            "type": "number"
          },
          "delayed": {
            "type": "number"
          },
          "failed": {
            "type": "number"
          },
          "completed": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "waiting",
          "active",
          "delayed",
          "failed",
          "completed"
        ]
      },
      "WorkerStatusDto": {
        "type": "object",
        "properties": {
          "workerGroup": {
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "workerGroup",
          "instanceId",
          "lastSeenAt",
          "stale"
        ]
      },
      "OpsStatusDto": {
        "type": "object",
        "properties": {
          "queues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueStatusDto"
            }
          },
          "workers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerStatusDto"
            }
          }
        },
        "required": [
          "queues",
          "workers"
        ]
      }
    }
  }
}
